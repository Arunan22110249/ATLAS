# Application
ENV=development
APP_NAME=ATLAS
APP_VERSION=1.0.0
DEBUG=false

# API
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# JWT
JWT_SECRET=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Database
DATABASE_URL=postgresql+asyncpg://atlas:atlas@localhost:5432/atlas
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0

# Kafka
KAFKA_BROKERS=localhost:9092

# Object Storage (MinIO)
STORAGE_URL=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=atlas-documents

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=atlas-vectors

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32

# LLM
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your-openai-api-key
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000

# RAG Configuration
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=50
RAG_RETRIEVAL_TOP_K=10
RAG_CONTEXT_LENGTH_TOKENS=4000
RAG_MIN_CONFIDENCE_SCORE=0.3
SEMANTIC_CACHE_TTL_SECONDS=86400
ENABLE_SEMANTIC_CACHE=true

# Document Processing
MAX_DOCUMENT_SIZE_MB=100
ALLOWED_DOCUMENT_TYPES=pdf,docx,txt,md,html,csv,json
DOCUMENT_PROCESSING_TIMEOUT=300

# Workers
WORKER_CONCURRENCY=4

# Observability
ENABLE_OTEL=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=*

# Security
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_SPECIAL=true
